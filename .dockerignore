# Dependencies
/node_modules
/vendor

# Laravel build artifacts (regenerated by the docker/frontend stage)
/public/build
/public/hot
/public/storage

# Bootstrap cache files are runtime-generated by `php artisan optimize` — never
# ship the local dev environment's stale cache (it references dev-only packages)
/bootstrap/cache/*.php

# Storage keys + runtime data (don't ship source code's local dev state)
/storage/*.key
/storage/framework/cache/data
/storage/framework/sessions
/storage/framework/views
/storage/framework/testing
/storage/logs/*.log

# Environment files (server-side .env lives on app-01, not in the image)
/.env
.env.backup
.env.production

# Testing / debugging artifacts
.phpunit.cache
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
auth.json

# IDE / OS files
/.fleet
/.idea
/.nova
/.vscode
/.zed
.DS_Store
Thumbs.db

# Source documentation not needed in the image
/docs
/README.md
/CLAUDE.md
/AGENTS.md